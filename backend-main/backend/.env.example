# Solana Network Settings
SOLANA_NETWORK=devnet

# Relayer Keypair (JSON format or base58 string depending on your setup)
# DO NOT COMMIT YOUR REAL SECRETS
SOLANA_PAYER_SECRET_KEY=[0,0,0,0,...]

# Backend API Settings
PORT=3015
API_SECRET_KEY=troque-esta-chave

# MariaDB local do docker compose (porta publicada 3308).
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=biotracer
DB_PASSWORD=biotracer
DB_NAME=biotracer

# Máximo de criações de lote por IP a cada 15 minutos. Estourar recusa a solicitação.
BATCH_CREATE_LIMIT=30
